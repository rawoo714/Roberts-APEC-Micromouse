{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug: Graphing",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "executable": "${workspaceFolder}/build/Debug/Micromouse_Firmware.elf",
            "armToolchainPath": "/home/robert/.local/share/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin",
            "device": "STM32F103",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            "graphConfig": [
                {
                    "label": "Velocity PID Tuning",
                    "timespan": 5,
                    "type": "realtime",
                    "plots": [
                        { "graphId": 1, "label": "Target Velocity", "color": "green", "variable": "tunnelNavigator.targetVelocity" },
                        { "graphId": 1, "label": "Current Velocity", "color": "red", "variable": "currentVelocity" }
                    ]
                },
                {
                    "label": "Power Outputs",
                    "timespan": 5,
                    "type": "realtime",
                    "plots": [
                        { "graphId": 2, "label": "Base Power", "color": "blue", "variable": "tunnelNavigator.basePower" },
                        { "graphId": 2, "label": "PID Correction", "color": "orange", "variable": "tunnelNavigator.basePowerPid" }
                    ]
                }
            ]
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 1000
            }
        }
    ]
}